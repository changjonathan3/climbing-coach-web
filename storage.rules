rules_version = '2';

// Clips, label images, and detector traces. Same ownership model as Firestore:
// a signed-in user can only touch files under their own users/{uid}/ prefix.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
